            "min": 0,
            "max": 1,
            "step": 0.01,
            "labelMultiplier": 100,
            "labelDecimals": 0
          },
          {
            "type": "autocomplete",
            "name": "zone",
            "placeholder": {
              "en": "Zone",
              "nl": "Ruimte"
            }
          },
          {
            "type": "dropdown",
            "name": "subzones",
            "placeholder": {
              "en": "Set Subzones",
