                  "nl": "Ja"
                }
              },
              {
                "id": "false",
                "label": {
                  "en": "False",
                  "nl": "Nee"
                }
              }
            ]
          },
          {
            "type": "autocomplete",
            "name": "zone",
            "placeholder": {
