        "id": "action_capability_log",
        "title": {
          "en": "Capability log",
          "nl": "Capability log"
        },
        "titleFormatted": {
          "en": "Retrieve the value from [[device]] for [[capability]] from [[numberof]] minutes ago",
          "nl": "Ontvang de waarde van [[device]] voor [[capability]] van [[numberof]] minuten geleden"
