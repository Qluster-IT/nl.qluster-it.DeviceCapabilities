{
  "id": "nl.qluster-it.DeviceCapabilities",
  "version": "1.2.0",
  "compatibility": ">=5.0.0",
  "sdk": 3,
  "brandColor": "#E8A713",
  "name": {
    "en": "Device Capabilities",
    "nl": "Apparaat mogelijkheden"
  },
  "description": {
    "en": "Enhance the capabilities of devices",
    "nl": "Verbeter de capabilities van apparaten"
  },
  "category": [
    "tools"
  ],
  "permissions": [
    "homey:manager:api"
  ],
  "source": "https://bitbucket.org/QlusterIT/nl.qluster-it.devicecapabilities/",
