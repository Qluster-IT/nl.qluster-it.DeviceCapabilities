              "nl": "Ruimte"
            }
          },
          {
            "type": "dropdown",
            "name": "subzones",
            "placeholder": {
              "en": "Set Subzones",
              "nl": "Stel sub-ruimte's in"
            },
            "values": [
              {
                "id": "yes",
