{
  "id": "nl.qluster-it.DeviceCapabilities",
  "version": "0.3.0",
  "compatibility": ">=5.0.0",
  "sdk": 3,
  "brandColor": "#E8A713",
  "name": {
    "en": "Device Capabilities",
    "nl": "Apparaat mogelijkheden"
  },
  "description": {
    "en": "Enhance the capabilities of devices",
    "nl": "Verbeter de capabilities van apparaten"
  },
  "category": [
    "tools"
  ],
  "permissions": [
    "homey:manager:api"
  ],
  "source": "https://bitbucket.org/QlusterIT/nl.qluster-it.devicecapabilities/",
  "bugs": {
    "url": "https://bitbucket.org/QlusterIT/nl.qluster-it.devicecapabilities/issues"
  },
  "homeyCommunityTopicId": 43287,
  "images": {
    "large": "/assets/images/large.png",
    "small": "/assets/images/small.png"
  },
  "author": {
    "name": "Arie J. Godschalk",
    "email": "arie@qluster-it.nl"
  },
  "flow": {
    "triggers": [
      {
        "id": "trigger_capability_changed",
        "title": {
          "en": "Capability listener",
          "nl": "Capability luisteraar"
        },
        "titleFormatted": {
          "en": "Listen (watch) from [[device]] for [[capability]]",
          "nl": "Luister (watch) van [[device]] naar [[capability]]"
        },
        "args": [
          {
            "type": "autocomplete",
            "name": "device",
            "placeholder": {
              "en": "Device",
              "nl": "Device"
            }
          },
          {
            "type": "autocomplete",
            "name": "capability",
            "placeholder": {
              "en": "Enter the exact device name",
              "nl": "Vul de exacte apparaat naam in"
            }
          }
        ],
        "tokens": [
          {
            "name": "value",
            "type": "string",
            "title": {
              "en": "value",
              "nl": "waarde"
            }
          }
        ]
      }
    ],
    "conditions": [
      {
        "id": "condition_change_capability_boolean",
        "title": {
          "en": "Capability listener",
          "nl": "Capability luisteraar"
        },
        "titleFormatted": {
          "en": "Set [[capability]] to [[value]] on [[device]] and continue after capability gives this error: [[error]]",
          "nl": "Set [[capability]] naar [[value]] op [[device]] en vervolg nadat de capability deze error geeft: [[error]]"
        },
        "args": [
          {
            "type": "autocomplete",
            "name": "device",
            "placeholder": {
              "en": "Device",
              "nl": "Device"
            }
          },
          {
            "type": "autocomplete",
            "name": "capability",
            "placeholder": {
              "en": "Enter the exact device name",
              "nl": "Vul de exacte apparaat naam in"
            }
          },
          {
            "type": "dropdown",
            "name": "value",
            "placeholder": {
              "en": "True or False",
              "nl": "Waar of Onwaar"
            },
            "values": [
              {
                "id": "true",
                "label": {
                  "en": "True",
                  "nl": "Waar"
                }
              },
              {
                "id": "false",
                "label": {
                  "en": "False",
                  "nl": "Onwaar"
                }
              }
            ]
          },
          {
            "name": "error",
            "type": "text",
            "title": {
              "en": "Error",
              "nl": "Foutmelding"
            }
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "set_capability_zone_text",
        "title": {
          "en": "Set text capabilities in a zone",
          "nl": "Zet tekst capabilities in een ruimte"
        },
        "titleFormatted": {
          "en": "Set [[capability]] to [[value]] in [[zone]] including subzones ([[subzones]])",
          "nl": "Zet [[capability]] naar [[value]] in [[zone]] inclusief subzones ([[subzones]])"
        },
        "args": [
          {
            "type": "autocomplete",
            "name": "capability",
            "placeholder": {
              "en": "Capability",
              "nl": "Capability"
            }
          },
          {
            "type": "text",
            "name": "value",
            "placeholder": {
              "en": "value",
              "nl": "value"
            }
          },
          {
            "type": "autocomplete",
            "name": "zone",
            "placeholder": {
              "en": "Zone",
              "nl": "Ruimte"
            }
          },
          {
            "type": "dropdown",
            "name": "subzones",
            "placeholder": {
              "en": "Set Subzones",
              "nl": "Stel sub-ruimte's in"
            },
            "values": [
              {
                "id": "yes",
                "label": {
                  "en": "Yes",
                  "nl": "Ja"
                }
              },
              {
                "id": "no",
                "label": {
                  "en": "No",
                  "nl": "Nee"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "set_capability_zone_percentage",
        "title": {
          "en": "Set percentage capabilities in a zone",
          "nl": "Zet procent capabilities in een zone"
        },
        "titleFormatted": {
          "en": "Set [[capability]] to [[value]] in [[zone]] including subzones ([[subzones]])",
          "nl": "Zet [[capability]] naar [[value]] in [[zone]] inclusief subzones ([[subzones]])"
        },
        "args": [
          {
            "type": "autocomplete",
            "name": "capability",
            "placeholder": {
              "en": "Capability",
              "nl": "Capability"
            }
          },
          {
            "type": "range",
            "name": "value",
            "placeholder": {
              "en": "%",
              "nl": "%"
            },
            "min": 0,
            "max": 1,
            "step": 0.01,
            "labelMultiplier": 100,
            "labelDecimals": 0
          },
          {
            "type": "autocomplete",
            "name": "zone",
            "placeholder": {
              "en": "Zone",
              "nl": "Ruimte"
            }
          },
          {
            "type": "dropdown",
            "name": "subzones",
            "placeholder": {
              "en": "Set Subzones",
              "nl": "Stel sub-ruimte's in"
            },
            "values": [
              {
                "id": "yes",
                "label": {
                  "en": "Yes",
                  "nl": "Ja"
                }
              },
              {
                "id": "no",
                "label": {
                  "en": "No",
                  "nl": "Nee"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "set_capability_zone_boolean",
        "title": {
          "en": "Set true/false capabilities in a zone",
          "nl": "Zet waar/onwaar capabilities in een ruimte"
        },
        "titleFormatted": {
          "en": "Set [[capability]] to [[value]] in [[zone]] including subzones ([[subzones]])",
          "nl": "Zet [[capability]] naar [[value]] in [[zone]] inclusief subzones ([[subzones]])"
        },
        "args": [
          {
            "type": "autocomplete",
            "name": "capability",
            "placeholder": {
              "en": "Capability",
              "nl": "Capability"
            }
          },
          {
            "type": "dropdown",
            "name": "value",
            "placeholder": {
              "en": "True or False",
              "nl": "Waar of Onwaar"
            },
            "values": [
              {
                "id": "true",
                "label": {
                  "en": "True",
                  "nl": "Waar"
                }
              },
              {
                "id": "false",
                "label": {
                  "en": "False",
                  "nl": "Onwaar"
                }
              }
            ]
          },
          {
            "type": "autocomplete",
            "name": "zone",
            "placeholder": {
              "en": "Zone",
              "nl": "Ruimte"
            }
          },
          {
            "type": "dropdown",
            "name": "subzones",
            "placeholder": {
              "en": "Set Subzones",
              "nl": "Stel sub-ruimte's in"
            },
            "values": [
              {
                "id": "yes",
                "label": {
                  "en": "Yes",
                  "nl": "Ja"
                }
              },
              {
                "id": "no",
                "label": {
                  "en": "No",
                  "nl": "Nee"
                }
              }
            ]
          }
        ]
      }
    ]
  }
}