  "flow": {
    "triggers": [
      {
        "id": "trigger_capability_changed",
        "deprecated":true,
        "title": {
          "en": "Capability listener",
          "nl": "Capability luisteraar"
        },
        "titleFormatted": {
          "en": "Listen (watch) from [[device]] for [[capability]]",
          "nl": "Luister (watch) van [[device]] naar [[capability]]"
        },
        "args": [
          {
            "type": "autocomplete",
            "name": "device",
            "placeholder": {
              "en": "Device",
              "nl": "Device"
            }
          },
          {
            "type": "autocomplete",
            "name": "capability",
            "placeholder": {
              "en": "Capability",
              "nl": "Mogelijkheid"
            }
          }
        ],
        "tokens": [
          {
            "name": "value",
            "type": "string",
            "title": {
              "en": "value",
              "nl": "waarde"
            }
          }
        ]
      },
      {
        "id": "trigger_capability_changed2",
        "title": {
          "en": "Capability listener",
          "nl": "Capability luisteraar"
        },
        "titleFormatted": {
          "en": "Listen (watch) from [[device]] for [[capability]]",
          "nl": "Luister (watch) van [[device]] naar [[capability]]"
        },
        "args": [
          {
            "type": "autocomplete",
            "name": "device",
            "placeholder": {
              "en": "Device",
              "nl": "Device"
            }
          },
          {
            "type": "autocomplete",
            "name": "capability",
            "placeholder": {
              "en": "Capability",
              "nl": "Mogelijkheid"
            }
          }
        ],
        "tokens": [
          {
            "name": "user",
            "type": "string",
            "title": {
              "en": "User",
              "nl": "Gebruiker"
            }
          },
          {
            "name": "client",
            "type": "string",
            "title": {
              "en": "Client",
              "nl": "Cliënt"
            }
          },
          {
            "name": "text1",
            "type": "string",
            "title": {
              "en": "Text 1",
              "nl": "Tekst 1"
            }
          },
          {
            "name": "number1",
            "type": "number",
            "title": {
              "en": "Number 1",
              "nl": "Nummer 1"
            }
          },
          {
            "name": "boolean1",
            "type": "boolean",
            "title": {
              "en": "Yes/No 1",
              "nl": "Ja/Nee 1"
            }
          }
        ]
      }
    ],
    "conditions": [
      {
        "id": "condition_change_capability_boolean",
        "title": {
          "en": "Capability listener",
          "nl": "Capability luisteraar"
        },
        "titleFormatted": {
          "en": "Set [[device]].[[capability]] to [[value]] and wait for error: [[error]]",
          "nl": "Set [[device]].[[capability]] naar [[value]] en wacht op error: [[error]]"
        },
        "args": [
          {
            "type": "autocomplete",
            "name": "device",
            "placeholder": {
              "en": "Device",
              "nl": "Device"
            }
          },
          {
            "type": "autocomplete",
            "name": "capability",
            "placeholder": {
              "en": "Capability",
              "nl": "Mogelijkheid"
            }
          },
          {
            "type": "dropdown",
            "name": "value",
            "placeholder": {
              "en": "True or False",
              "nl": "Ja of Nee"
            },
            "values": [
              {
                "id": "true",
                "label": {
                  "en": "True",
                  "nl": "Ja"
                }
              },
              {
                "id": "false",
                "label": {
                  "en": "False",
                  "nl": "Nee"
                }
              }
            ]
          },
          {
            "name": "error",
            "type": "text",
            "title": {
              "en": "Error",
              "nl": "Foutmelding"
            }
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "set_capability_zone_text",
        "title": {
          "en": "Set text capabilities in a zone",
          "nl": "Zet tekst capabilities in een ruimte"
        },
        "titleFormatted": {
          "en": "Set [[capability]] to [[value]] in [[zone]] including subzones ([[subzones]])",
          "nl": "Zet [[capability]] naar [[value]] in [[zone]] inclusief subzones ([[subzones]])"
        },
        "args": [
          {
            "type": "autocomplete",
            "name": "capability",
            "placeholder": {
              "en": "Capability",
              "nl": "Capability"
            }
          },
          {
            "type": "text",
            "name": "value",
            "placeholder": {
              "en": "value",
              "nl": "value"
            }
          },
          {
            "type": "autocomplete",
            "name": "zone",
            "placeholder": {
              "en": "Zone",
              "nl": "Ruimte"
            }
          },
          {
            "type": "dropdown",
            "name": "subzones",
            "placeholder": {
              "en": "Set Subzones",
              "nl": "Stel sub-ruimte's in"
            },
            "values": [
              {
                "id": "yes",
                "label": {
                  "en": "Yes",
                  "nl": "Ja"
                }
              },
              {
                "id": "no",
                "label": {
                  "en": "No",
                  "nl": "Nee"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "set_capability_zone_percentage",
