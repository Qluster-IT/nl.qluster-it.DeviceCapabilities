{
    "flows": [
        {
            "id": "virtualdevice_set_status",
            "title": {
                "en": "Set Status",
                "nl": "Zet Status"
            },
            "titleFormatted": {
                "en": "Set Status to [[text]], [[refreshmobilebug]]",
                "nl": "Zet Status naar [[text]], [[refreshmobilebug]]"
            },
            "args": [
                {
                    "name": "device",
                    "type": "device",
                    "filter": "driver_id=virtualdevice"
                },
                {
                    "type": "text",
                    "name": "text",
                    "placeholder": {
                        "en": "Text",
                        "nl": "Tekst"
                    },
                    "required": false
                },
                {
                    "type": "checkbox",
                    "name": "refreshmobilebug",
                    "placeholder": {
                        "en": "Optionally Update Mobile App",
                        "nl": "Update Mobile App optioneel"
                    },
                    "required": false
                }
            ]
        },
        {
            "id": "virtualdevice_set_status_optionalnumber",
            "title": {
                "en": "Set Status with Number",
                "nl": "Zet Status met Nummer"
            },
            "titleFormatted": {
